{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "baseBranches": ["dev"],
  "timezone": "Asia/Bangkok",
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 5,
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "One weekly PR for all non-major updates",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Majors one at a time, never auto-merged",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Keep GitHub Actions pinned and grouped",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  }
}

# Local mock-data mode. Copy to `.env.local` (gitignored); it takes precedence
# over `.env`, so `pnpm dev:api` then talks to the local Supabase stack instead
# of the shared staging/prod database. Delete `.env.local` to switch back.
#
# These are the Supabase CLI's public demo keys for 127.0.0.1 only. They are
# not secrets and do not work against any hosted project.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# A local-only secret so tokens minted locally are useless against prod.
JWT_SECRET=local-only-jwt-secret-change-me-at-least-32-chars
WATERMARK_SECRET=local-only-watermark-secret

# Skip OpenTelemetry export locally.
OTEL_SDK_DISABLED=true
